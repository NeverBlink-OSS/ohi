---
// The logo links to the ohi.dev home page, not to the docs home
import OhiLogo from '../assets/ohi-logo.svg';
import OhiLogoDark from '../assets/ohi-logo-dark.svg';
---

<a href="/" class="site-title sl-flex" aria-label="ohi.dev home">
  <OhiLogoDark class="light:sl-hidden" />
  <OhiLogo class="dark:sl-hidden" />
</a>

<style>
  .site-title {
    align-items: center;
    min-width: 0;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .site-title :global(svg) {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    max-width: 100%;
  }
</style>
