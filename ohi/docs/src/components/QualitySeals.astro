---
const star = 'M68 44L74.9 59.5L91.8 61.3L79.2 72.6L82.7 89.2L68 80.8L53.3 89.2L56.8 72.6L44.2 61.3L61.1 59.5Z';

// smallStars holds the x positions of the small stars under the star. Their number tells the medals apart without color.
const seals = [
  { medal: 'gold', name: 'Gold', praise: 'An excellent example for others.', smallStars: [55.5, 68, 80.5] },
  { medal: 'silver', name: 'Silver', praise: 'A strong and thoughtful contribution.', smallStars: [61.75, 74.25] },
  { medal: 'bronze', name: 'Bronze', praise: 'Promising work worth exploring.', smallStars: [68] },
];
---

<ul class="quality-seals not-content">
  {
    seals.map(({ medal, name, praise, smallStars }) => (
      <li>
        <svg class={medal} viewBox="0 0 136 136" aria-hidden="true">
          <defs>
            <path id={`quality-seal-arc-${medal}`} d="M20.5 68A47.5 47.5 0 0 1 115.5 68" />
          </defs>
          <text class="caption"><textPath href={`#quality-seal-arc-${medal}`} startOffset="50%">OHI SEAL OF QUALITY</textPath></text>
          <path d="M77.5 117.1C76 121.3 82.5 125.2 90 124.5C87 117.7 80.5 113.8 77.5 117.1ZM83.3 115.6C86.6 117.3 90.5 112.4 90.7 106.1C84.8 107.9 80.9 112.8 83.3 115.6ZM88.9 113.4C88.4 117.7 95.3 119.8 102 117.5C97.7 111.8 90.9 109.7 88.9 113.4ZM94.1 110.6C97.5 111.4 100 106 98.9 100.3C93.7 103.2 91.3 108.6 94.1 110.6ZM99 107.2C99.5 111.2 106.3 111.6 112 108.1C106.8 103.8 100 103.3 99 107.2ZM103.5 103.3C106.8 103.2 107.8 97.7 105.5 92.7C101.4 96.5 100.4 102 103.5 103.3ZM107.4 98.8C108.8 102.3 115.1 101.2 119.5 96.6C113.8 93.9 107.5 95 107.4 98.8ZM110.8 93.9C113.8 93.1 113.6 87.8 110.3 83.7C107.4 88.1 107.7 93.4 110.8 93.9ZM113.6 88.6C115.6 91.5 121.1 89.1 124.2 83.9C118.3 82.7 112.8 85.1 113.6 88.6ZM115.7 83C118.3 81.7 116.9 76.9 113 73.9C111.3 78.5 112.8 83.3 115.7 83ZM117.1 77.3C119.7 79.5 124.1 76 125.8 70.7C120.2 70.8 115.7 74.2 117.1 77.3ZM117.9 71.3C120 69.5 117.6 65.5 113.4 63.6C112.9 68.2 115.3 72.2 117.9 71.3ZM117.9 65.4C121 64.6 120.7 59.3 117.4 55.2C114.6 59.7 114.8 64.9 117.9 65.4Z" />
          <path class="line" d="M77.5 117.1A50 50 0 0 0 117.9 65.4M58.5 117.1A50 50 0 0 1 18.1 65.4" />
          <circle cx="18.1" cy="65.4" r="1.6" />
          <path class="star" d={star} />
          {/* Scaled around (68, 69), the middle of the star */}
          {smallStars.map((x) => (
            <path class="star" d={star} transform={`translate(${x} 102) scale(0.2) translate(-68 -69)`} />
          ))}
        </svg>
        <strong>{name}</strong>{' '}
        <span>{praise}</span>
      </li>
    ))
  }
</ul>

<style>
  .quality-seals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-block: 1.5rem;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  svg {
    width: 8.5rem;
    max-width: 100%;
    margin-bottom: 0.5rem;
    fill: currentColor;
  }

  .gold {
    color: #e6b93f;
  }

  .silver {
    color: #c3c9d4;
  }

  .bronze {
    color: #db945c;
  }

  :global(:root[data-theme='light']) .gold {
    color: #8a5d00;
  }

  :global(:root[data-theme='light']) .silver {
    color: #5a6478;
  }

  :global(:root[data-theme='light']) .bronze {
    color: #9a4a1a;
  }

  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .star {
    stroke: currentColor;
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .caption {
    font-family: var(--sl-font-mono);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-anchor: middle;
  }

  strong {
    color: var(--sl-color-white);
  }

  span {
    font-size: 0.875rem;
  }

  /* The caption is too small to read once the seals shrink to fit */
  @media (max-width: 34rem) {
    .caption {
      display: none;
    }
  }
</style>
